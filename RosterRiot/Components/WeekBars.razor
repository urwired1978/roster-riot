@* Bar chart of fantasy points by week. A null value is a week he didn't play (bye or out).
   Plain HTML (not a stretched SVG) so the numbers stay crisp at any width and bar heights can ease. *@
@{
    var vals = Values ?? [];
    var max = Math.Max(vals.Where(v => v is not null).Select(v => v!.Value).DefaultIfEmpty(0).Max(), Average ?? 0) * 1.08;
    if (max <= 0) max = 1;
    var showVals = vals.Count <= 18;
}
<div class="bars" role="img" aria-label="Points by week">
    <div class="bars-plot">
        @if (Average is { } avg && avg > 0)
        {
            // The plot area for bars is the full height minus the 18px top padding for value labels.
            <div class="bar-avg" style="bottom:calc((100% - 18px) * @((avg / max).ToString("0.####", Inv)))"></div>
        }
        @for (var i = 0; i < vals.Count; i++)
        {
            var v = vals[i];
            <div class="bar-col">
                @if (v is { } val)
                {
                    var cls = Average is { } a ? (val >= a ? "hi" : "lo") : "hi";
                    @if (showVals) { <span class="bar-val">@val.ToString("0")</span> }
                    <span class="bar @cls" style="height:@((val / max * 100).ToString("0.##", Inv))%"></span>
                }
                else
                {
                    <span class="bar-val muted">–</span>
                }
            </div>
        }
    </div>
    <div class="bars-x" aria-hidden="true">
        @for (var i = 0; i < vals.Count; i++)
        {
            <span class="bar-lbl">@(Labels is not null && i < Labels.Count ? Labels[i] : (i + 1).ToString())</span>
        }
    </div>
</div>

@code {
    static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    [Parameter] public List<double?>? Values { get; set; }
    [Parameter] public List<string>? Labels { get; set; }
    [Parameter] public double? Average { get; set; }
}
