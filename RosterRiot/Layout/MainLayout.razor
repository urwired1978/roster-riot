@inherits LayoutComponentBase
@implements IDisposable
@inject LeagueService S
@inject BuzzService Buzz
@inject NavigationManager Nav

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <img class="brand-logo" src="img/rr.png" alt="" />
            <span class="brand-text">
                <span class="brand-name">ROSTER <b>RIOT</b></span>
                <span class="brand-sub">@(S.Ready ? S.TeamName(S.MyRoster) : "Loading") · @(S.League?.Name ?? "Sleeper") · Wk @S.Week</span>
            </span>
        </a>
        <button class="refresh @(S.Refreshing ? "spin" : "")" @onclick="Refresh" aria-label="Refresh">
            @if (S.Games.Any(g => g.IsLive)) { <span class="live-dot"></span> }
            <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" /></svg>
        </button>
    </header>

    @if (S.Error is { } err)
    {
        <div class="banner bad" @onclick="Refresh">@err</div>
    }

    <main class="content">
        @if (!S.Ready)
        {
            @if (S.Error is null)
            {
                <div class="splash">
                    <img src="img/logo-full.png" alt="Roster Riot" class="splash-logo" />
                    <div class="splash-text">Loading the league…</div>
                </div>
            }
        }
        else
        {
            @Body
            <footer class="foot">
                <img class="foot-mark" src="img/wordmark.png" alt="Roster Riot. Your team. Every move." />
                @if (S.UpdatedAt is { } t) { <span>Updated @t.ToLocalTime().ToString("h:mm:ss tt")</span> }
                <span>Data: Sleeper and ESPN · Buzz: ESPN, CBS Sports, Bluesky</span>
                <span>Built with Claude Code</span>
            </footer>
        }
    </main>

    <nav class="tabbar">
        <NavLink class="tab" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg><span>Matchup</span>
        </NavLink>
        <NavLink class="tab" href="team">
            <svg viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-8 0M4 21c0-4 3.5-6 8-6s8 2 8 6M12 7V3" /></svg><span>My Team</span>
        </NavLink>
        <NavLink class="tab" href="league">
            <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4" /></svg><span>League</span>
        </NavLink>
        <NavLink class="tab" href="buzz">
            <svg viewBox="0 0 24 24"><path d="M3 10v4h3l6 4V6L6 10zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" /></svg><span>Buzz</span>
            @if (AlertCount > 0) { <span class="tab-dot">@AlertCount</span> }
        </NavLink>
        <NavLink class="tab" href="waivers">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /><circle cx="12" cy="12" r="9" /></svg><span>Pickups</span>
        </NavLink>
        <NavLink class="tab" href="nfl">
            <svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="9.5" ry="5.5" transform="rotate(-35 12 12)" /><path d="M9.5 14.5l5-5M10.5 11.5l2 2M12.5 9.5l2 2" /></svg><span>NFL</span>
        </NavLink>
    </nav>
</div>

@code {
    // Off-field or legal heads-ups on my own players, shown as a dot on the Buzz tab.
    int AlertCount => S.Ready ? Buzz.Mine.Count(p => Buzz.AlertFor(p)?.Kind == BuzzAlertKind.OffField) : 0;

    protected override async Task OnInitializedAsync()
    {
        S.Changed += OnChanged;
        Buzz.Changed += OnChanged;
        await S.EnsureLoadedAsync();
        await Buzz.StartAsync();
    }

    void OnChanged() => InvokeAsync(StateHasChanged);
    async Task Refresh()
    {
        _ = Buzz.RefreshAsync(force: true);
        await S.RefreshAsync(full: true);
    }
    public void Dispose()
    {
        S.Changed -= OnChanged;
        Buzz.Changed -= OnChanged;
    }
}
