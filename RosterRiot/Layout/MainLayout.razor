@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject LeagueService S
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <img class="brand-logo" src="img/rr.png" alt="" />
            <span class="brand-text">
                <span class="brand-name">ROSTER <b>RIOT</b></span>
                <span class="brand-sub">@(S.Ready ? S.TeamName(S.MyRoster) : "Loading") · @(S.League?.Name ?? "Sleeper") · Wk @S.Week</span>
            </span>
        </a>
        <button class="refresh @(S.Refreshing ? "spin" : "")" @onclick="Refresh" aria-label="Refresh scores">
            @if (S.Games.Any(g => g.IsLive)) { <span class="live-dot"></span> }
            <Icon Name="refresh" />
        </button>
    </header>

    @if (S.Error is { } err && S.Ready)
    {
        <button class="banner bad" @onclick="Refresh">
            <Icon Name="offline" />
            <span>@err</span>
            <span class="banner-act">Retry</span>
        </button>
    }

    <main class="content">
        @if (!S.Ready)
        {
            @if (S.Error is { } loadErr)
            {
                <EmptyState Icon="offline" Bad="true" Title="Can't reach Sleeper" Text="@loadErr" ActionText="Try again" OnAction="Refresh" />
            }
            else
            {
                <Skeleton Kind="@SkeletonKind" />
            }
        }
        else
        {
            @Body
            <footer class="foot">
                <span class="foot-brand"><img src="img/rr.png" alt="" /><span>ROSTER <b>RIOT</b></span></span>
                @if (S.UpdatedAt is { } t) { <span>Updated @t.ToLocalTime().ToString("h:mm tt")</span> }
                <span>Data from Sleeper and ESPN · Built with Claude Code</span>
            </footer>
        }
    </main>

    <nav class="tabbar">
        <NavLink class="tab" href="" Match="NavLinkMatch.All"><Icon Name="matchup" /><span>Matchup</span></NavLink>
        <NavLink class="tab" href="team"><Icon Name="team" /><span>My Team</span></NavLink>
        <NavLink class="tab" href="league"><Icon Name="league" /><span>League</span></NavLink>
        <NavLink class="tab" href="waivers"><Icon Name="pickups" /><span>Pickups</span></NavLink>
        <NavLink class="tab" href="nfl"><Icon Name="nfl" /><span>NFL</span></NavLink>
    </nav>
</div>

@code {
    IJSObjectReference? polish;
    DotNetObjectReference<MainLayout>? self;
    DateTimeOffset? lastUpdate;

    // Loading placeholder shaped like the screen being opened.
    string SkeletonKind => Nav.ToBaseRelativePath(Nav.Uri).Split('/', '?')[0] switch
    {
        "" or "matchup" => "matchup",
        _ => "list"
    };

    protected override async Task OnInitializedAsync()
    {
        S.Changed += OnChanged;
        await S.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            self = DotNetObjectReference.Create(this);
            polish = await JS.InvokeAsync<IJSObjectReference>("import", Nav.BaseUri + "js/rr-polish.js");
            await polish.InvokeVoidAsync("init", self);
        }
        catch (Exception ex) { Console.WriteLine($"Polish module didn't load: {ex.Message}"); }
    }

    void OnChanged()
    {
        // New scores: let the numbers on screen ease to their new values.
        if (S.UpdatedAt != lastUpdate && polish is not null && lastUpdate is not null) _ = polish.InvokeVoidAsync("markLive").AsTask();
        lastUpdate = S.UpdatedAt;
        InvokeAsync(StateHasChanged);
    }

    Task Refresh() => S.RefreshAsync(full: true);

    /// <summary>Called by js/rr-polish.js when the user pulls down past the threshold and lets go.</summary>
    [JSInvokable]
    public Task PullRefresh() => S.RefreshAsync(full: true);

    public async ValueTask DisposeAsync()
    {
        S.Changed -= OnChanged;
        self?.Dispose();
        if (polish is not null) { try { await polish.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
